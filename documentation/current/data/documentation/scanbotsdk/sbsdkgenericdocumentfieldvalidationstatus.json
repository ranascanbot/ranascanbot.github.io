te fields, etc. that have check digits or a known format that can be validated.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The VALID status gives the strongest guarantee that the field value has been read out without errors."}],"navigatorTitle":[{"text":"valid","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"valid"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@ScanbotSDK@objc(cs)SBSDKGenericDocumentFieldValidationStatus","text":"SBSDKGenericDocumentFieldValidationStatus"}],"url":"\/documentation\/scanbotsdk\/sbsdkgenericdocumentfieldvalidationstatus\/valid","kind":"symbol","role":"symbol","title":"valid"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGenericDocumentFieldValidationStatus/confirmed":{"url":"\/documentation\/scanbotsdk\/sbsdkgenericdocumentfieldvalidationstatus\/confirmed","navigatorTitle":[{"text":"confirmed","kind":"identifier"}],"abstract":[{"type":"text","text":"The same field value was recognized in multiple frames, thereby confirming the value."},{"text":" ","type":"text"},{"type":"text","text":"Occurs only for fields that have no validation rules otherwise."},{"type":"text","text":" "},{"type":"text","text":"A CONFIRMED value gives a strong guarantee that the field value has been read out without errors,"},{"type":"text","text":" "},{"type":"text","text":"but not as strong as VALID. The value may still be incorrect, due to systemic OCR errors."},{"type":"text","text":" "},{"type":"text","text":"In case of OCR errors, increase the number of frames needed to confirm the value in the"},{"text":" ","type":"text"},{"text":"recognizer configuration.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","t