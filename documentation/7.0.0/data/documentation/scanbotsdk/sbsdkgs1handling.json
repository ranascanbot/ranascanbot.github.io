{"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"ScanbotSDK"}],"externalID":"c:@M@ScanbotSDK@E@SBSDKGS1Handling","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1Handling"}],"symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SBSDKGS1Handling"}],"roleHeading":"Enumeration","title":"SBSDKGS1Handling"},"topicSections":[{"anchor":"Enumeration-Cases","generated":true,"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeStructure","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/parse","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateStructure"],"title":"Enumeration Cases"},{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/init(rawValue:)"],"title":"Initializers"},{"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/Equatable-Implementations","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/RawRepresentable-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/net.doo.ScanbotSDK\/Se","doc:\/\/net.doo.ScanbotSDK\/SE","doc:\/\/net.doo.ScanbotSDK\/SQ","doc:\/\/net.doo.ScanbotSDK\/SH","doc:\/\/net.doo.ScanbotSDK\/SY"]}],"abstract":[{"type":"text","text":"GS1 message handling options."},{"type":"text","text":" "},{"type":"text","text":"The GS1 standard defines a a key-value format for business-centric data that can be encoded into many 1D and 2D"},{"type":"text","text":" "},{"text":"barcode types.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"https:\/\/ref.gs1.org\/standards\/genspecs\/"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@objc","kind":"attribute"},{"text":"(SBSDKGS1Handling) ","kind":"text"},{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SBSDKGS1Handling"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"GS1 messages have two representations or formats: a human-readable format and a"},{"text":" ","type":"text"},{"type":"text","text":"machine-readable format. The human-readable format uses parentheses to wrap the keys in each"},{"text":" ","type":"text"},{"type":"text","text":"pair. For example, the string “(01)012345678901(37)02(3922)00278” contains three AI keys:"},{"type":"text","text":" "},{"type":"text","text":"01, 37, and 3922. The corresponding values are 012345678901, 02, and 00278."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The machine-readable format uses the special ASCII \\x1D character to terminate key-value","type":"text"},{"text":" ","type":"text"},{"text":"pairs in the string in cases where the given key implies that the value is variable-length.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The equivalent machine-readable string for the above example is"},{"text":" ","type":"text"},{"type":"text","text":"“010123456789013702\\x1D392200278”."},{"type":"text","text":" "},{"type":"text","text":"In the above example, the 01 AI key is fixed-length, so the \\x1D character is not necessary."},{"text":" ","type":"text"},{"type":"text","text":"The 37 AI keys is variable-length, so the \\x1D character is necessary after the value in the"},{"text":" ","type":"text"},{"type":"text","text":"pair. The 3922 AI key is also variable-length, but it is the last pair in the message, so"},{"text":" ","type":"text"},{"text":"the \\x1D character is not necessary at the end.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The character \\x1D is UNPRINTABLE - this means that if you try to print or otherwise","type":"text"},{"type":"text","text":" "},{"type":"text","text":"visualize a GS1 message containing the \\x1D character, you may see a number of different"},{"text":" ","type":"text"},{"type":"text","text":"results, depending on how the system handles unprintable characters. You may see a question"},{"text":" ","type":"text"},{"text":"mark, a box, an escape sequence, a space or nothing at all.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/scanbotsdk\/sbsdkgs1handling"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/scanbotsdk\/sbsdkgs1handling"]}],"references":{"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/decodeStructure":{"navigatorTitle":[{"text":"SBSDKGS1HandlingDecodeStructure","kind":"identifier"}],"kind":"symbol","title":"SBSDKGS1Handling.decodeStructure","type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeStructure","role":"symbol","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/decodestructure","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"decodeStructure"}],"abstract":[{"type":"text","text":"Same as VALIDATE_STRUCTURE. Additionally, GS1 strings are converted to the human-readable format,"},{"type":"text","text":" "},{"type":"text","text":"instead (with parentheses used to wrap AI keys, e.g. “(01)123456789”). The \\x1D character is"},{"type":"text","text":" "},{"type":"text","text":"never used in this representation."}]},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/validateFull":{"type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateFull","navigatorTitle":[{"text":"SBSDKGS1HandlingValidateFull","kind":"identifier"}],"kind":"symbol","title":"SBSDKGS1Handling.validateFull","abstract":[{"text":"Includes all validations from VALIDATE_STRUCTURE. Additionally, GS1 messages which have missing or incompatible","type":"text"},{"text":" ","type":"text"},{"text":"combinations of AI keys are rejected. Additionally, values are checked against a list of known linting rules,","type":"text"},{"type":"text","text":" "},{"text":"e.g. checksums are calculated and verified, dates are checked for validity, etc. Results that fail any of the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"linter rules are rejected. The complete set of linter rules from the GS1 Syntax Dictionary are implemented."}],"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/validatefull","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"validateFull","kind":"identifier"}],"role":"symbol"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling":{"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SBSDKGS1Handling"}],"title":"SBSDKGS1Handling","navigatorTitle":[{"text":"SBSDKGS1Handling","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling","abstract":[{"type":"text","text":"GS1 message handling options."},{"type":"text","text":" "},{"text":"The GS1 standard defines a a key-value format for business-centric data that can be encoded into many 1D and 2D","type":"text"},{"type":"text","text":" "},{"type":"text","text":"barcode types."},{"type":"text","text":" "},{"text":"https:\/\/ref.gs1.org\/standards\/genspecs\/","type":"text"}],"type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling","role":"symbol"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/Equatable-Implementations":{"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/Equatable-Implementations","role":"collectionGroup","abstract":[],"kind":"article","type":"topic","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/equatable-implementations","title":"Equatable Implementations"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/init(rawValue:)":{"type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/init(rawValue:)","kind":"symbol","title":"init(rawValue:)","abstract":[],"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/init(rawvalue:)","fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"?("},{"text":"rawValue","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}],"role":"symbol"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK":{"role":"collection","kind":"symbol","url":"\/documentation\/scanbotsdk","title":"ScanbotSDK","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK","abstract":[{"text":"Version: 7.0.0","type":"text"}],"type":"topic"},"doc://net.doo.ScanbotSDK/Se":{"type":"unresolvable","identifier":"doc:\/\/net.doo.ScanbotSDK\/Se","title":"Swift.Decodable"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/RawRepresentable-Implementations":{"kind":"article","title":"RawRepresentable Implementations","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/rawrepresentable-implementations","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/RawRepresentable-Implementations","abstract":[],"type":"topic","role":"collectionGroup"},"doc://net.doo.ScanbotSDK/SH":{"type":"unresolvable","identi