{"variants":[{"paths":["\/documentation\/scanbotsdk\/sbsdkgs1handling"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/scanbotsdk\/sbsdkgs1handling"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"SBSDKGS1Handling","kind":"identifier"}],"navigatorTitle":[{"text":"SBSDKGS1Handling","kind":"identifier"}],"role":"symbol","title":"SBSDKGS1Handling","externalID":"c:@M@ScanbotSDK@E@SBSDKGS1Handling","symbolKind":"enum","modules":[{"name":"ScanbotSDK"}]},"kind":"symbol","abstract":[{"text":"GS1 message handling options. The GS1 standard defines a","type":"text"},{"type":"text","text":" "},{"text":"a key-value format for business-centric data","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that can be encoded into many 1D and 2D barcode types."},{"text":" ","type":"text"},{"text":"https:\/\/ref.gs1.org\/standards\/genspecs\/","type":"text"}],"hierarchy":{"paths":[["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/net.doo.ScanbotSDK\/SQ","doc:\/\/net.doo.ScanbotSDK\/SH","doc:\/\/net.doo.ScanbotSDK\/SY"],"title":"Conforms To","type":"conformsTo"}],"topicSections":[{"anchor":"Enumeration-Cases","identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeStructure","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/none","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/parse","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateStructure"],"title":"Enumeration Cases","generated":true},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/init(rawValue:)"],"anchor":"Initializers"},{"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/Equatable-Implementations","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/RawRepresentable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SBSDKGS1Handling"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"GS1 messages have two representations or formats: a human-readable format and a"},{"text":" ","type":"text"},{"text":"machine-readable format. The human-readable format uses parentheses to wrap the keys in each","type":"text"},{"type":"text","text":" "},{"text":"pair. For example, the string “(01)012345678901(37)02(3922)00278” contains three AI keys:","type":"text"},{"type":"text","text":" "},{"type":"text","text":"01, 37, and 3922. The corresponding values are 012345678901, 02, and 00278."}],"type":"paragraph"},{"inlineContent":[{"text":"The machine-readable format uses the special ASCII \\x1D character to terminate key-value","type":"text"},{"type":"text","text":" "},{"type":"text","text":"pairs in the string in cases where the given key implies that the value is variable-length."},{"text":" ","type":"text"},{"type":"text","text":"The equivalent machine-readable string for the above example is"},{"text":" ","type":"text"},{"text":"“010123456789013702\\x1D392200278”.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"In the above example, the 01 AI key is fixed-length, so the \\x1D character is not necessary."},{"type":"text","text":" "},{"text":"The 37 AI keys is variable-length, so the \\x1D character is necessary after the value in the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"pair. The 3922 AI key is also variable-length, but it is the last pair in the message, so"},{"type":"text","text":" "},{"type":"text","text":"the \\x1D character is not necessary at the end."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The character \\x1D is UNPRINTABLE - this means that if you try to print or otherwise"},{"text":" ","type":"text"},{"type":"text","text":"visualize a GS1 message containing the \\x1D character, you may see a number of different"},{"text":" ","type":"text"},{"text":"results, depending on how the system handles unprintable characters. You may see a question","type":"text"},{"type":"text","text":" "},{"text":"mark, a box, an escape sequence, a space or nothing at all.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"references":{"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK":{"role":"collection","url":"\/documentation\/scanbotsdk","kind":"symbol","title":"ScanbotSDK","type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK","abstract":[{"type":"text","text":"Version: 6.1.2"}]},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/none":{"navigatorTitle":[{"text":"SBSDKGS1HandlingNone","kind":"identifier"}],"abstract":[{"type":"text","text":"The (FNC1) character is simply stripped from the result in barcodes that implement this"},{"type":"text","text":" "},{"text":"mode.","type":"text"},{"type":"text","text":" "},{"text":"Do not use. Will be removed in a future release.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"none"}],"kind":"symbol","identifier":"do