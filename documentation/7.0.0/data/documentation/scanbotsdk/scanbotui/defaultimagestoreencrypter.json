{"abstract":[{"type":"text","text":"The SBSDKUI-component-wide encrypter for storing image data to disk. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"metadata":{"externalID":"c:@M@ScanbotSDK@objc(cs)ScanbotUI(cpy)defaultImageStoreEncrypter","role":"symbol","modules":[{"name":"ScanbotSDK"}],"fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"defaultImageStoreEncrypter","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@M@ScanbotSDK@objc(pl)SBSDKStorageCrypting","text":"SBSDKStorageCrypting","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"roleHeading":"Type Property","title":"defaultImageStoreEncrypter","navigatorTitle":[{"text":"defaultImageStoreEncrypter","kind":"identifier"}],"symbolKind":"property"},"identifier":{"url":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/ScanbotUI\/defaultImageStoreEncrypter","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/ScanbotUI"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultImageStoreEncrypter","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@ScanbotSDK@objc(pl)SBSDKStorageCrypting","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKStorageCrypting","text":"SBSDKStorageCrypting"},{"text":"?","kind":"text"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"If set to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" no encryption is used at all.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can use the built-in encrypter ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKAESEncrypter"},{"text":" to encrypt your sensitive image data","type":"text"},{"text":" ","type":"text"},{"text":"using AES128 or AES256 before storing it to disk.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"When using encryption you still can access the unencrypted images in the image storage."},{"type":"text","text":" "},{"type":"text","text":"Of course, encrypted storages cannot be read without the proper encrypter being set here."},{"type":"text","text":" "},{"type":"text","text":"You are responsible for migrating image storages."}]},{"content":[{"inlineContent":[{"text":"If you wish to use the ScanbotSDK RTU-UI-wide encryption setup your encrypter before using any of the ScanbotSDK RTU-UI API.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A good place to configure it, is your "},{"type":"codeVoice","code":"AppDelegate"},{"text":"’s entry point, right where the license is set.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Once ScanbotSDK RTU-UI API is used the storages are created and any change to the default encrypter is of no effect."}]},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For standard components, prefixed with SBSDK (without UI) the default encrypter has no effect, since there is"},{"text":" ","type":"text"},{"type":"text","text":"no image storage by default. You can, of course, create instances of "},{"type":"reference","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKKeyedImageStorage","isActive":true},{"type":"text","text":" "},{"type":"text","text":"and "},{"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKIndexedImageStorage","type":"reference","isActive":true},{"text":" and initialize them with an encrypter of your choice.","type":"text"}]}],"name":"Note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/scanbotsdk\/scanbotui\/defaultimagestoreencrypter"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/scanbotsdk\/scanbotui\/defaultimagestoreencrypter"]}],"kind":"symbol","references":{"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKStorageCrypting":{"navigatorTitle":[{"kind":"identifier","text":"SBSDKStorageCrypting"}],"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKStorageCrypting","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"text":"SBSDKStorageCrypting","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/scanbotsdk\/sbsdkstoragecrypting","title":"SBSDKStorageCrypting","abstract":[{"text":"Protocol for implementing encryption and decryption of (streamed) data.","type":"text"}]},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK":{"role":"collection","kind":"symbol","url":"\/documentation\/scanbotsdk","title":"ScanbotSDK","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK","abstract":[{"text":"Version: 7.0.0","type":"text"}],"type":"topic"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKAESEncrypter":{"navigatorTitle":[{"kind":"identifier","text":"SBSDKAESEncrypter"}],"abstract":[{"type":"text","text":"ScanbotSDK’s default data encrypter. Provides AES128 and AES 256 encryption to your data."},{"type":"text","text":" "},{"text":"All data is encrypted and decrypted with the same key.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The context being passed to the encrypt\/decrypt methods is ignored."}],"url":"\/documentation\/scanbotsdk\/sbsdkaesencrypter","role":"symbol","fragments":[{"text":"cl