{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK"]]},"metadata":{"platforms":[{"unavailable":false,"name":"iOS","introducedAt":"14.0","deprecated":false,"beta":false},{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"14.0","name":"iPadOS"},{"name":"Mac Catalyst","introducedAt":"14.0","deprecated":false,"beta":false,"unavailable":false}],"modules":[{"name":"ScanbotSDK"}],"title":"SBSDKHKDFKeyGenerator","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SBSDKHKDFKeyGenerator"}],"role":"symbol","roleHeading":"Class","externalID":"c:@M@ScanbotSDK@objc(cs)SBSDKHKDFKeyGenerator","symbolKind":"class","navigatorTitle":[{"text":"SBSDKHKDFKeyGenerator","kind":"identifier"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"text":"A key generator that uses the HMAC based HKDF algorithm to generate a new encryption key. SHA512 is used as the hash function.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The key generation consists of two phases: extraction and expansion."},{"type":"text","text":" "},{"type":"text","text":"During the extraction a pseudo random key is generated from the input key material and an optional salt."},{"text":" ","type":"text"},{"type":"text","text":"The expansion phase uses the pseudo random key and the info data block to derive the final key."}],"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKHKDFKeyGenerator\/init(inputKeyMaterial:info:salt:)"],"title":"Initializers"},{"title":"Instance Methods","anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKHKDFKeyGenerator\/generateKey(keyLength:)"]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/net.doo.ScanbotSDK\/objc(cs)NSObject"],"title":"Inherits From","type":"inhe