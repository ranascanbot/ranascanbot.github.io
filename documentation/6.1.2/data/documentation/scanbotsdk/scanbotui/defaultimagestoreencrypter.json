{"sections":[],"hierarchy":{"paths":[["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/ScanbotUI"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultImageStoreEncrypter","kind":"identifier"},{"kind":"text","text":": "},{"text":"SBSDKStorageCrypting","preciseIdentifier":"c:@M@ScanbotSDK@objc(pl)SBSDKStorageCrypting","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKStorageCrypting","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"languages":["swift"],"platforms":["iOS"]}]},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"If set to ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" no encryption is used at all."}],"type":"paragraph"},{"inlineContent":[{"text":"You can use the built-in encrypter ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKAESEncrypter"},{"type":"text","text":" to encrypt your sensitive image data"},{"text":" ","type":"text"},{"text":"using AES128 or AES256 before storing it to disk.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"When using encryption you still can access the unencrypted images in the image storage."},{"text":" ","type":"text"},{"text":"Of course, encrypted storages cannot be read without the proper encrypter being set here.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"You are responsible for migrating image storages."}],"type":"paragraph"},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"If you wish to use the ScanbotSDK RTU-UI-wide encryption setup your encrypter before using any of the ScanbotSDK RTU-UI API."}],"type":"paragraph"}],"type":"aside","name":