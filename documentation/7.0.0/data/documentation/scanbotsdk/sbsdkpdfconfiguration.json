{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":"(SBSDKPDFConfiguration) ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SBSDKPDFConfiguration"}],"platforms":["iOS"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"pageSize","type":"codeVoice"},{"type":"text","text":" is "},{"code":"CUSTOM","type":"codeVoice"},{"type":"text","text":":"},{"type":"text","text":" "},{"text":"in this case ","type":"text"},{"code":"dpi","type":"codeVoice"},{"type":"text","text":" is used as the conversion ratio to calculate both the physical page and"},{"text":" ","type":"text"},{"text":"image sizes in inches from the bitmap dimensions. ","type":"text"},{"type":"codeVoice","code":"resamplingMethod"},{"type":"text","text":" is ignored."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"pageSize"},{"type":"text","text":" is not "},{"type":"codeVoice","code":"CUSTOM"},{"type":"text","text":" AND "},{"type":"codeVoice","code":"pageFit"},{"type":"text","text":" is "},{"code":"NONE","type":"codeVoice"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"in this case ","type":"text"},{"type":"codeVoice","code":"dpi"},{"type":"text","text":" is used as the conversion ratio to calculate only the physical image"},{"text":" ","type":"text"},{"type":"text","text":"size in inches from the bitmap dimensions. The image is centered onto the page."},{"type":"text","text":" "},{"type":"codeVoice","code":"resamplingMethod"},{"text":" is ignored.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"pageSize","type":"codeVoice"},{"type":"text","text":" is not "},{"code":"CUSTOM","type":"codeVoice"},{"type":"text","text":" AND "},{"type":"codeVoice","code":"pageFit"},{"text":" is not ","type":"text"},{"type":"codeVoice","code":"NONE"},{"text":":","type":"text"},{"type":"text","text":" "},{"text":"in this case the page has a pre-determined physical size and we want to stretch the image to","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fit the page in one of the ways described by "},{"type":"codeVoice","code":"pageFit"},{"type":"text","text":". The image DPI is automatically"},{"text":" ","type":"text"},{"type":"text","text":"calculated for each image from the given physical page size, page fit setting and image"},{"type":"text","text":" "},{"text":"dimensions. There are two sub-cases to consider:","type":"text"},{"type":"text","text":" "},{"text":"a. ","type":"text"},{"code":"resamplingMethod","type":"codeVoice"},{"text":" is NONE OR the calculated DPI is less than or equal to ","type":"text"},{"type":"codeVoice","code":"dpi"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"in this case the image is added to the PDF without resampling, which means that the image"},{"type":"text","text":" "},{"type":"text","text":"rectangle is simply rescaled to fit into the page as specified by "},{"code":"pageFit","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"pageSize","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"b. "},{"type":"codeVoice","code":"resamplingMethod"},{"type":"text","text":" is not NONE AND the calculated DPI is greater than "},{"code":"dpi","type":"codeVoice"},{"type":"text","text":":"},{"text":" ","type":"text"},{"text":"in this case the bitmap of the image is resampled to match ","type":"text"},{"type":"codeVoice","code":"dpi"},{"type":"text","text":" using the selected method"},{"type":"text","text":" "},{"type":"text","text":"before adding it to the PDF. This will result in a bitmap that is smaller than the"},{"type":"text","text":" "},{"text":"original image and hence, the resulting PDF will be smaller in size.","type":"text"}]}]}],"type":"orderedList"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration"},"abstract":[{"text":"The parameters ","type":"text"},{"type":"codeVoice","code":"pageSize"},{"type":"text","text":", "},{"type":"codeVoice","code":"pageFit"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dpi"},{"type":"text","text":" and "},{"type":"codeVoice","code":"resamplingMethod"},{"text":" interact in a complex way","type":"text"},{"text":" ","type":"text"},{"text":"when adding bitmap images (JPEG, PNG, or raw) to the PDF.","type":"text"},{"type":"text","text":" "},{"text":"There are three cases to consider:","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration\/init()"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration\/attributes","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration\/dpi","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration\/jpegQuality","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration\/pageDirection","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration\/pageFit","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration\/pageSize","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration\/resamplingMethod"]},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKPDFConfiguration\/toJson(configuration:)"],"anchor":"Instance-Methods"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/net.doo.Scanbo