},{"type":"text","text":" "},{"text":"image sizes in inches from the bitmap dimensions. ","type":"text"},{"type":"codeVoice","code":"resamplingMethod"},{"type":"text","text":" is ignored."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pageSize"},{"text":" is not ","type":"text"},{"type":"codeVoice","code":"CUSTOM"},{"text":" AND ","type":"text"},{"type":"codeVoice","code":"pageFit"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"NONE"},{"text":":","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in this case "},{"code":"dpi","type":"codeVoice"},{"text":" is used as the conversion ratio to calculate only the physical image","type":"text"},{"type":"text","text":" "},{"text":"size in inches from the bitmap dimensions. The image is centered onto the page.","type":"text"},{"text":" ","type":"text"},{"code":"resamplingMethod","type":"codeVoice"},{"type":"text","text":" is ignored."}]}]},{"content":[{"inlineContent":[{"code":"pageSize","type":"codeVoice"},{"type":"text","text":" is not "},{"code":"CUSTOM","type":"codeVoice"},{"text":" AND ","type":"text"},{"type":"codeVoice","code":"pageFit"},{"type":"text","text":" is not "},{"type":"codeVoice","code":"NONE"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"in this case the page has a pre-determined physical size and we want to stretch the image to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"fit the page in one of the ways described by "},{"code":"pageFit","type":"codeVoice"},{"type":"text","text":". The image DPI is automatically"},{"type":"text","text":" "},{"text":"calculated for each image from the given physical page size, page fit setting and image","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"dimensions. There are two sub-cases to consider:"},{"type":"text","text":" "},{"type":"text","text":"a. "},{"type":"codeVoice","code":"resamplingMethod"},{"type":"text","text":" is NONE OR the calculated DPI is less than or equal to "},{"type":"codeVoice","code":"dpi"},{"type":"text","text":":"},{"text":" ","type":"text"},{"type":"text","text":"in this case the image is added to the PDF without resampling, which means that the image"},{"type":"text","text":" "},{"type":"text","text":"rectangle is simply rescaled to fit into the page as specified by "},{"code":"pageFit","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"pageSize","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"b. "},{"code":"resamplingMethod","type":"codeVoice"},{"type":"text","text":" is not NONE AND the calculated DPI is greater than "},{"type":"codeVoice","code":"dpi"},{"type":"text","text":":"},{"text":" ","type":"text"},{"type":"text","text":"in this case the bitmap of the image is resampled to match "},{"code":"dpi","type":"codeVoice"},{"type":"text","text":" using the selected method"},{"type":"text","text":" "},{"type":"text","text":"before adding it to the PDF. This will result in a bitmap that is smaller than the"},{"type":"text","text":" "},{"text":"original image and hence, the resulting PDF will be smaller in size.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"metadata":{"symbolKind":"class","externalID":"c:@M@ScanbotSDK@objc(cs)SBSDKPDFConfiguration","roleHeading":"Class","role":"symbol","navigatorTitle":[{"text":"SBSDKPDFConfiguration","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"SBSDKPDFConfiguration","kind":"identifier"}],"title":"SBSDKPDFConfiguration","modules":[{"name":"ScanbotSDK"}]},"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/net.doo.ScanbotSDK\/objc(cs)NSObject"]},{"identifiers":["doc:\/\/net.doo.ScanbotSDK\/objc(pl)NSCopying","doc:\/\/net.doo.ScanbotSDK\/objc(pl)NSObject