{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/scanbotsdk\/sbsdkeuropeanhealthinsurancecardrecognizerconfiguration\/allowedcountries"]},{"paths":["\/documentation\/scanbotsdk\/sbsdkeuropeanhealthinsurancecardrecognizerconfiguration\/allowedcountries"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"allowedCountries","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"c:@M@ScanbotSDK@objc(cs)SBSDKEuropeanHealthInsuranceCardIssuingCountry","text":"SBSDKEuropeanHealthInsuranceCardIssuingCountry","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKEuropeanHealthInsuranceCardIssuingCountry","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"platforms":["iOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"single country: validation rules for the given country are used starting from the first","type":"text"},{"text":" ","type":"text"},{"text":"frame. If the country cannot be inferred or the inferred country doesn’t","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"match the given country, the result of recognize() will be IncompleteValidation."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"multiple countries: the country is inferred from the card number first."},{"type":"text","text":" "},{"text":"Until the country is detected, the document fields are not OCR’d and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"accumulated. Once the country is inferred, the field accumulation starts"},{"text":" ","type":"text"},{"type":"text","text":"and the inferred country validation rules are applied."},{"type":"text","text":" "},{"type":"text","text":"If the country cannot be inferred or the inferred country doesn’t match"},{"type":"text","text":" "},{"text":"any of the countries in the list, the result status will be IncompleteValidation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"empty list: same as “multiple countries” with one additional detail.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the country cannot be inferred within "},{"type":"codeVoice","code":"maxCountryDetectionAttempts"},{"text":" successive frames in which the","type":"text"},{"type":"text","text":" "},{"text":"part of the card number that stores the country code was successfully OCR’d, then the country is","type":"text"},{"type":"text","text":" "},{"text":"inferred to be Unknown and no validation rules are applied. Field accumulation then proceeds normally.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"In this case recognize() can eventually return Success and the document will have a CountryType of Unknown."}]}]}],"identifier":{"url":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKEuropeanHealthInsuranceCardRecognizerConfiguration\/allowedCountries","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKEuropeanHealthInsuranceCardRecognizerConfiguration"]]},"abstract":[{"text":"List of allowed countries for the EHIC. If:","type":"text"}],"sections":[],"kind":"symbol","metadata":{"modules":[{"name":"ScanbotSDK"}],"roleHeading":"Instance Property","externalID":"c:@M@ScanbotSDK@objc(cs)SBSDKEuropeanHealthInsuranceCardRecognizerConfiguration(py)allowedCountries","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"allowedCountries"},{"text":": [","kind":"text"},{"preciseIdentifier":"c:@M@ScanbotSDK@objc(cs)