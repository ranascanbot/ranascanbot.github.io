{"hierarchy":{"paths":[["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK"]]},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/net.doo.ScanbotSDK\/objc(cs)NSObject"],"kind":"relationships"},{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/net.doo.ScanbotSDK\/objc(pl)NSObject","doc:\/\/net.doo.ScanbotSDK\/s7CVarArgP","doc:\/\/net.doo.ScanbotSDK\/s28CustomDebugStringConvertibleP","doc:\/\/net.doo.ScanbotSDK\/s23CustomStringConvertibleP","doc:\/\/net.doo.ScanbotSDK\/Se","doc:\/\/net.doo.ScanbotSDK\/SE","doc:\/\/net.doo.ScanbotSDK\/SQ","doc:\/\/net.doo.ScanbotSDK\/SH"]}],"topicSections":[{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus\/rawValue"]},{"generated":true,"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus\/confirmed","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus\/ignored","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus\/inferred","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus\/invalid","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus\/none","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus\/valid"],"title":"Type Properties","anchor":"Type-Properties"},{"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus\/enumValue(from:)"],"generated":true,"anchor":"Type-Methods","title":"Type Methods"}],"abstract":[{"text":"Field validation status.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":"(SBSDKGenericDocumentFieldValidationStatus) "},{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SBSDKGenericDocumentFieldValidationStatus"}],"languages":["swift"],"platforms":["iOS"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Optical character recognition (OCR) invariably introduces errors in the recognized text."},{"type":"text","text":" "},{"type":"text","text":"There are numerous ways to verify that what has been recognized is, in fact, what was"},{"type":"text","text":" "},{"type":"text","text":"written in the document."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The best way to validate the value of a field is for it to have a known format or validation"},{"text":" ","type":"text"},{"type":"text","text":"logic. For example, an IBAN number has a known format and two check digits that make it"},{"text":" ","type":"text"},{"text":"very unlikely that a value with OCR errors will pass validation. Fields with known","type":"text"},{"type":"text","text":" "},{"text":"validation rules will have a validation status of either VALID or INVALID.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Fields whose value can be inferred from other fields, or from domain knowledge (for example,"},{"text":" ","type":"text"},{"type":"text","text":"the field may have the same value in every instance of this type of document), will have the"},{"text":" ","type":"text"},{"type":"text","text":"status INFERRED. Inferring the value of a field is a strong validation method, provided that"},{"text":" ","type":"text"},{"type":"text","text":"there are no unexpected changes to the document format."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Fields that do not have validation rules and cannot be inferred can still be validated by checking whether the same"},{"type":"text","text":" "},{"type":"text","text":"value is recognized from multiple attempts, e.g. across multiple frames of a camera stream."},{"text":" ","type":"text"},{"text":"If the same value is recognized in multiple frames, the value is considered CONFIRMED, otherwise","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it will have the status NONE. This is the least strict validation method, as it does not protect"},{"text":" ","type":"text"},{"type":"text","text":"from systemic OCR errors, but in practice it still provides good results for most fields."}]}],"kind":"content"}],"metadata":{"navigatorTitle":[{"text":"SBSDKGenericDocumentFieldValidationStatus","kind":"identifier"}],"role":"symbol","roleHeading":"Class","title":"SBSDKGenericDocumentFieldValidationStatus","modules":[{"name":"ScanbotSDK"}],"symbolKind":"class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SBSDKGenericDocumentFieldValidationStatus","kind":"identifier"}],"externalID":"c:@M@ScanbotSDK@objc(cs)SBSDKGenericDocumentFieldValidationStatus"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/scanbotsdk\/sbsdkgenericdocumentfieldvalidationstatus"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/scanbotsdk\/sbsdkgenericdocumentfieldvalidationstatus"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGenericDocumentFieldValidationStatus/inferred":{"title":"inferred","url":"\/documentation\/scanbotsdk\/sbsdkgenericdocumentfieldvalidationstatus\/inferred","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"inferred","kind":"identifier"},{"kind":"text","text":": "},{"text":"SBSDKGenericDocumentFieldValidationStatus","kind":"typeIdentifier","preciseIdentifier":"c:@M@ScanbotSDK@objc(cs)SBSDKGenericDocumentFieldValidationStatus"}],"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGenericDocumentFieldValidationStatus\/inferred","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"inferred"}],"abstract":[{"text":"Field value was inferred from other fields or from domain knowledge.","type":"text"},{"text":" ","type":"text"},{"text":"The field value may differ from what is actually written in the document in unexpected situations.","type":"text"}],"type":"topic"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGenericDocumentFieldValidationStatus/confirmed":{"abstract":[{"text":"The same field value was recognized in multiple frames, thereby confirming the value.","type":"text"},{"text":" ","type":"text"},{"text":"Occurs only for fields that have no validation rules otherwise.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"A CONFIRMED value gives a strong guarantee that the field value has been read out without errors,"},{"text":" ","type":"text"},{"text":"but not as strong as VALID. The value may still be incorrect, due to systemic OCR errors.","type":"text"},{"type":"text","text":" "},{"text":"In case of OCR errors, increase the number of frames needed to confirm the value in the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"recognizer configuration."}],"title":"confirmed","navigatorTitle":[{"text":"confirmed","kind":"identifier"}],"type":"topic","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"confirmed"},{"text":": ","kind":"text"},{"text":"SBSDKGenericDocumentFieldValidationStatus","preciseIdentifier":"c:@M@ScanbotSDK@objc(cs)SBSDKGenericDocumentFieldValidationStatus","kin