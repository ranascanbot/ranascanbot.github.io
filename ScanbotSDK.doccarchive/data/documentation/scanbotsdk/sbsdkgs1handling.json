{"topicSections":[{"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeStructure","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/parse","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateStructure"],"title":"Enumeration Cases","generated":true,"anchor":"Enumeration-Cases"},{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/init(rawValue:)"],"title":"Initializers"},{"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/Equatable-Implementations","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/RawRepresentable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@objc","kind":"attribute"},{"kind":"text","text":"(SBSDKGS1Handling) "},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SBSDKGS1Handling","kind":"identifier"}],"languages":["swift"],"platforms":["iOS"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"GS1 messages have two representations or formats: a human-readable format and a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"machine-readable format. The human-readable format uses parentheses to wrap the keys in each"},{"text":" ","type":"text"},{"text":"pair. For example, the string “(01)012345678901(37)02(3922)00278” contains three AI keys:","type":"text"},{"text":" ","type":"text"},{"text":"01, 37, and 3922. The corresponding values are 012345678901, 02, and 00278.","type":"text"}]},{"inlineContent":[{"text":"The machine-readable format uses the special ASCII \\x1D character to terminate key-value","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"pairs in the string in cases where the given key implies that the value is variable-length."},{"type":"text","text":" "},{"text":"The equivalent machine-readable string for the above example is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"“010123456789013702\\x1D392200278”."},{"text":" ","type":"text"},{"type":"text","text":"In the above example, the 01 AI key is fixed-length, so the \\x1D character is not necessary."},{"text":" ","type":"text"},{"text":"The 37 AI keys is variable-length, so the \\x1D character is necessary after the value in the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"pair. The 3922 AI key is also variable-length, but it is the last pair in the message, so"},{"text":" ","type":"text"},{"text":"the \\x1D character is not necessary at the end.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The character \\x1D is UNPRINTABLE - this means that if you try to print or otherwise","type":"text"},{"type":"text","text":" "},{"text":"visualize a GS1 message containing the \\x1D character, you may see a number of different","type":"text"},{"type":"text","text":" "},{"text":"results, depending on how the system handles unprintable characters. You may see a question","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"mark, a box, an escape sequence, a space or nothing at all."}],"type":"paragraph"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"symbol","externalID":"c:@M@ScanbotSDK@E@SBSDKGS1Handling","modules":[{"name":"ScanbotSDK"}],"fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"SBSDKGS1Handling","kind":"identifier"}],"title":"SBSDKGS1Handling","roleHeading":"Enumeration","navigatorTitle":[{"text":"SBSDKGS1Handling","kind":"identifier"}],"symbolKind":"enum"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/net.doo.ScanbotSDK\/Se","doc:\/\/net.doo.ScanbotSDK\/SE","doc:\/\/net.doo.ScanbotSDK\/SQ","doc:\/\/net.doo.ScanbotSDK\/SH","doc:\/\/net.doo.ScanbotSDK\/SY"]}],"variants":[{"paths":["\/documentation\/scanbotsdk\/sbsdkgs1handling"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/scanbotsdk\/sbsdkgs1handling"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling"},"abstract":[{"type":"text","text":"GS1 message handling options."},{"text":" ","type":"text"},{"type":"text","text":"The GS1 standard defines a a key-value format for business-centric data that can be encoded into many 1D and 2D"},{"type":"text","text":" "},{"type":"text","text":"barcode types."},{"type":"text","text":" "},{"type":"text","text":"https:\/\/ref.gs1.org\/standards\/genspecs\/"}],"hierarchy":{"paths":[["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK"]]},"references":{"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/Equatable-Implementations":{"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/equatable-implementations","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/Equatable-Implementations","type":"topic","title":"Equatable Implementations","role":"collectionGroup","abstract":[],"kind":"article"},"doc://net.doo.ScanbotSDK/Se":{"title":"Swift.Decodable","identifier":"doc:\/\/net.doo.ScanbotSDK\/Se","type":"unresolvable"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling":{"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1Handling"}],"type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling","abstract":[{"text":"GS1 message handling options.","type":"text"},{"text":" ","type":"text"},{"text":"The GS1 standard defines a a key-value format for business-centric data that can be encoded into many 1D and 2D","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"barcode types."},{"type":"text","text":" "},{"type":"text","text":"https:\/\/ref.gs1.org\/standards\/genspecs\/"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"SBSDKGS1Handling","kind":"identifier"}],"kind":"symbol","title":"SBSDKGS1Handling"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/init(rawValue:)":{"kind":"symbol","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/init(rawvalue:)","title":"init(rawValue:)","abstract":[],"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/init(rawValue:)","role":"symbol","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"kind":"text","text":"?("},{"kind":"externalParam","text":"rawValue"},{"kind":"text","text":": "},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"kind":"text","text":")"}]},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/decodeStructure":{"abstract":[{"type":"text","text":"Same as VALIDATE_STRUCTURE. Additionally, GS1 strings are converted to the human-readable format,"},{"type":"text","text":" "},{"type":"text","text":"instead (with parentheses used to wrap AI keys, e.g. “(01)123456789”). The \\x1D character is"},{"type":"text","text":" "},{"type":"text","text":"never used in this representation."}],"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/decodestructure","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeStructure","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"decodeStructure","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1HandlingDecodeStructure"}],"title":"SBSDKGS1Handling.decodeStructure"},"doc://net.doo.ScanbotSDK/SQ":{"identifier":"doc:\/\/net.doo.ScanbotSDK\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/decodeFull":{"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"decodeFull"}],"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/decodefull","abstract":[{"type":"text","text":"Combines the validations of VALIDATE_FULL and the human-readable output format of DECODE_STRUCTURE."}],"title":"SBSDKGS1Handling.decodeFull","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeFull","navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1HandlingDecodeFull"}],"type":"topic","role":"symbol"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/RawRepresentable-Implementations":{"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/rawrepresentable-implementations","title":"RawRepresentable Implementations","type":"topic","abstract":[],"role":"collectionGroup","kind":"article","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/RawRepresentable-Implementations"},"doc://net.doo.ScanbotSDK/SY":{"identifier":"doc:\/\/net.doo.ScanbotSDK\/SY","type":"unresolvable","title":"Swift.RawRepresentable"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK":{"kind":"symbol","role":"collection","title":"ScanbotSDK","type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK","abstract":[{"type":"text","text":"Version: 7.0.0"}],"url":"\/documentation\/scanbotsdk"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/validateStructure":{"kind":"symbol","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/validatestructure","title":"SBSDKGS1Handling.validateStructure","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateStructure","role":"symbol","abstract":[{"text":"Same as PARSE. Additionally, messages containing unknown AI keys, or containing values","type":"text"},{"text":" ","type":"text"},{"text":"that don’t fulfill the length, character set or regex requirements for known keys, are rejected.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"validateStructure","kind":"identifier"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1HandlingValidateStructure"}]},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/validateFull":{"fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"validateFull","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1HandlingValidateFull"}],"title":"SBSDKGS1Handling.validateFull","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/validatefull","abstract":[{"type":"text","text":"Includes all validations from VALIDATE_STRUCTURE. Additionally, GS1 messages which have missing or incompatible"},{"text":" ","type":"text"},{"type":"text","text":"combinations of AI keys are rejected. Additionally, values are checked against a list of known linting rules,"},{"text":" ","type":"text"},{"type":"text","text":"e.g. checksums are calculated and verified, dates are checked for validity, etc. Results that fail any of the"},{"text":" ","type":"text"},{"type":"text","text":"linter rules are rejected. The complete set of linter rules from the GS1 Syntax Dictionary are implemented."}],"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateFull","type":"topic","role":"symbol","kind":"symbol"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/parse":{"kind":"symbol","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/parse","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"parse"}],"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/parse","type":"topic","navigatorTitle":[{"text":"SBSDKGS1HandlingParse","kind":"identifier"}],"title":"SBSDKGS1Handling.parse","role":"symbol","abstract":[{"type":"text","text":"This is the default. GS1 messages are converted to the machine-readable format per"},{"text":" ","type":"text"},{"text":"the GS1 spec (the special FNC1 character is converted to ASCII \\x1D).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The implied 01 AI key is prepended to DataBar results."},{"type":"text","text":" "},{"text":"No validation is performed.","type":"text"}]},"doc://net.doo.ScanbotSDK/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/net.doo.ScanbotSDK\/SH"},"doc://net.doo.ScanbotSDK/SE":{"title":"Swift.Encodable","type":"unresolvable","identifier":"doc:\/\/net.doo.ScanbotSDK\/SE"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"op":"replace","value":"occ","path":"\/identifier\/interfaceLanguage"},{"path":"\/metadata\/roleHeading","op":"replace","value":"Enumeration"},{"op":"replace","path":"\/metadata\/title","value":"SBSDKGS1Handling"},{"value":"enum","op":"replace","path":"\/metadata\/symbolKind"},{"op":"replace","path":"\/metadata\/fragments","value":[{"text":"SBSDKGS1Handling","kind":"identifier"}]},{"op":"replace","path":"\/metadata\/navigatorTitle","value":[{"kind":"identifier","text":"SBSDKGS1Handling"}]},{"value":[{"anchor":"Enumeration-Cases","identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeStructure","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/parse","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateStructure"],"title":"Enumeration Cases","generated":true}],"path":"\/to