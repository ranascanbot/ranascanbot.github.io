SDKGS1Handling.validateStructure","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"validateStructure","kind":"identifier"}],"navigatorTitle":[{"text":"SBSDKGS1HandlingValidateStructure","kind":"identifier"}],"abstract":[{"type":"text","text":"Same as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/parse"},{"text":". Additionally, messages containing unknown AI keys, or containing values","type":"text"},{"text":" ","type":"text"},{"text":"of incorrect format for known keys, are not returned.","type":"text"}]},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/Equatable-Implementations":{"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/Equatable-Implementations","type":"topic","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/equatable-implementations","abstract":[],"kind":"article","title":"Equatable Implementations","role":"collectionGroup"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/parse":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1HandlingParse"}],"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/parse","abstract":[{"text":"This is the default. GS1 messages are converted to the machine-readable format per","type":"text"},{"type":"text","text":" "},{"text":"the GS1 spec (the special FNC1 character is converted to ASCII \\x1D).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The implied 01 AI key is prepended to DataBar results."},{"text":" ","type":"text"},{"text":"No validation is performed.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"parse"}],"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/parse","title":"SBSDKGS1Handling.parse","kind":"symbol"},"doc://net.doo.ScanbotSDK/document