{"relationshipsSections":[{"identifiers":["doc:\/\/net.doo.ScanbotSDK\/SQ","doc:\/\/net.doo.ScanbotSDK\/SH","doc:\/\/net.doo.ScanbotSDK\/SY"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"GS1 message handling options. The GS1 standard defines a"},{"text":" ","type":"text"},{"type":"text","text":"a key-value format for business-centric data"},{"type":"text","text":" "},{"text":"that can be encoded into many 1D and 2D barcode types.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"https:\/\/ref.gs1.org\/standards\/genspecs\/"}],"metadata":{"roleHeading":"Enumeration","modules":[{"name":"ScanbotSDK"}],"navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1Handling"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"SBSDKGS1Handling","kind":"identifier"}],"title":"SBSDKGS1Handling","symbolKind":"enum","externalID":"c:@M@ScanbotSDK@E@SBSDKGS1Handling"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/scanbotsdk\/sbsdkgs1handling"]},{"paths":["\/documentation\/scanbotsdk\/sbsdkgs1handling"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"generated":true,"anchor":"Enumeration-Cases","title":"Enumeration Cases","identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeStructure","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/none","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/parse","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateFull","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateStructure"]},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/init(rawValue:)"],"anchor":"Initializers"},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/Equatable-Implementations","doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/RawRepresentable-Implementations"]}],"hierarchy":{"paths":[["doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@objc"},{"kind":"text","text":" "},{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SBSDKGS1Handling"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"GS1 messages have two representations or formats: a human-readable format and a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"machine-readable format. The human-readable format uses parentheses to wrap the keys in each"},{"type":"text","text":" "},{"text":"pair. For example, the string “(01)012345678901(37)02(3922)00278” contains three AI keys:","type":"text"},{"type":"text","text":" "},{"text":"01, 37, and 3922. The corresponding values are 012345678901, 02, and 00278.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The machine-readable format uses the special ASCII \\x1D character to terminate key-value"},{"type":"text","text":" "},{"type":"text","text":"pairs in the string in cases where the given key implies that the value is variable-length."},{"type":"text","text":" "},{"text":"The equivalent machine-readable string for the above example is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"“010123456789013702\\x1D392200278”."},{"type":"text","text":" "},{"text":"In the above example, the 01 AI key is fixed-length, so the \\x1D character is not necessary.","type":"text"},{"type":"text","text":" "},{"text":"The 37 AI keys is variable-length, so the \\x1D character is necessary after the value in the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"pair. The 3922 AI key is also variable-length, but it is the last pair in the message, so"},{"type":"text","text":" "},{"type":"text","text":"the \\x1D character is not necessary at the end."}]},{"type":"paragraph","inlineContent":[{"text":"The character \\x1D is UNPRINTABLE - this means that if you try to print or otherwise","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"visualize a GS1 message containing the \\x1D character, you may see a number of different"},{"type":"text","text":" "},{"type":"text","text":"results, depending on how the system handles unprintable characters. You may see a question"},{"type":"text","text":" "},{"text":"mark, a box, an escape sequence, a space or nothing at all.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling","interfaceLanguage":"swift"},"references":{"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK":{"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK","url":"\/documentation\/scanbotsdk","role":"collection","title":"ScanbotSDK","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Version: 6.2.1"}]},"doc://net.doo.ScanbotSDK/SH":{"title":"Swift.Hashable","identifier":"doc:\/\/net.doo.ScanbotSDK\/SH","type":"unresolvable"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/decodeFull":{"navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1HandlingDecodeFull"}],"abstract":[{"type":"text","text":"Same as "},{"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeStructure","type":"reference","isActive":true},{"type":"text","text":", but with full validation."}],"kind":"symbol","type":"topic","title":"SBSDKGS1Handling.decodeFull","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"decodeFull","kind":"identifier"}],"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeFull","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/decodefull","role":"symbol"},"doc://net.doo.ScanbotSDK/SY":{"title":"Swift.RawRepresentable","identifier":"doc:\/\/net.doo.ScanbotSDK\/SY","type":"unresolvable"},"doc://net.doo.ScanbotSDK/SQ":{"title":"Swift.Equatable","identifier":"doc:\/\/net.doo.ScanbotSDK\/SQ","type":"unresolvable"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/validateFull":{"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/validatefull","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Full validation including linting and checksums. This is the most strict mode."}],"type":"topic","title":"SBSDKGS1Handling.validateFull","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"text":"validateFull","kind":"identifier"}],"navigatorTitle":[{"text":"SBSDKGS1HandlingValidateFull","kind":"identifier"}],"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateFull"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/none":{"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/none","type":"topic","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"none","kind":"identifier"}],"abstract":[{"type":"text","text":"The (FNC1) character is simply stripped from the result in barcodes that implement this"},{"type":"text","text":" "},{"text":"mode.","type":"text"},{"type":"text","text":" "},{"text":"Do not use. Will be removed in a future release.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1HandlingNone"}],"kind":"symbol","title":"SBSDKGS1Handling.none","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/none"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/init(rawValue:)":{"type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/init(rawValue:)","abstract":[],"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/init(rawvalue:)","fragments":[{"kind":"identifier","text":"init"},{"text":"?(","kind":"text"},{"text":"rawValue","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"role":"symbol","kind":"symbol","title":"init(rawValue:)"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling":{"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling","title":"SBSDKGS1Handling","navigatorTitle":[{"kind":"identifier","text":"SBSDKGS1Handling"}],"abstract":[{"type":"text","text":"GS1 message handling options. The GS1 standard defines a"},{"text":" ","type":"text"},{"type":"text","text":"a key-value format for business-centric data"},{"text":" ","type":"text"},{"type":"text","text":"that can be encoded into many 1D and 2D barcode types."},{"text":" ","type":"text"},{"type":"text","text":"https:\/\/ref.gs1.org\/standards\/genspecs\/"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"SBSDKGS1Handling","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/Equatable-Implementations":{"title":"Equatable Implementations","role":"collectionGroup","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/equatable-implementations","kind":"article","abstract":[],"type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/Equatable-Implementations"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/parse":{"title":"SBSDKGS1Handling.parse","kind":"symbol","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/parse","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"parse","kind":"identifier"}],"navigatorTitle":[{"text":"SBSDKGS1HandlingParse","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"This is the default. GS1 messages are converted to the machine-readable format per"},{"text":" ","type":"text"},{"type":"text","text":"the GS1 spec (the special FNC1 character is converted to ASCII \\x1D)."},{"text":" ","type":"text"},{"type":"text","text":"The implied 01 AI key is prepended to DataBar results."},{"type":"text","text":" "},{"text":"No validation is performed.","type":"text"}],"url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/parse"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/decodeStructure":{"fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"decodeStructure"}],"navigatorTitle":[{"text":"SBSDKGS1HandlingDecodeStructure","kind":"identifier"}],"abstract":[{"text":"Same as ","type":"text"},{"identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/validateStructure","type":"reference","isActive":true},{"type":"text","text":", except that GS1 strings are converted to the human-readable"},{"type":"text","text":" "},{"type":"text","text":"format, instead (with parentheses used to wrap AI keys, e.g. “(01)123456789”)."},{"type":"text","text":" "},{"type":"text","text":"The \\x1D character is never used in this representation."}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/net.doo.ScanbotSDK\/documentation\/ScanbotSDK\/SBSDKGS1Handling\/decodeStructure","url":"\/documentation\/scanbotsdk\/sbsdkgs1handling\/decodestructure","title":"SBSDKGS1Handling.decodeStructure"},"doc://net.doo.ScanbotSDK/documentation/ScanbotSDK/SBSDKGS1Handling/validateStructure":{"abstract":[{"text":"Same as ","type":"text"},{